  "Policies": [
    {
      "PolicyName": "WebAppPolicy",
      "PolicyArn": "arn:aws:iam::123456789012:policy/WebAppPolicy",
      "PolicyVersionList": [
        {
          "VersionId": "v1",
          "IsDefaultVersion": true,
          "Document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "S3Access",
