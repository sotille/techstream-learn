          "Document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "BroadAccess",
                "Effect": "Allow",
                "Action": [
                  "iam:CreatePolicyVersion",
                  "iam:PassRole",
                  "lambda:*",
                  "s3:*",
                  "ec2:RunInstances"
                ],
                "Resource": "*"
              }
            ]
          }
        }
      ]
    },
    {
      "PolicyName": "DeveloperAccess",
