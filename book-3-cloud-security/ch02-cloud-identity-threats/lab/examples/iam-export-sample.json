          "Document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "DevTools",
                "Effect": "Allow",
                "Action": [
                  "s3:*",
                  "cloudformation:*",
                  "iam:CreateRole",
                  "iam:AttachRolePolicy",
                  "iam:PutRolePolicy"
